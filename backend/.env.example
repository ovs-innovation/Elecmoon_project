# Backend environment template — copy to .env and fill values.
PORT=8083
MONGO_URI=
JWT_SECRET=
JWT_SECRET_FOR_VERIFY=
ENCRYPT_PASSWORD=

PHONEPE_ENV=production
PHONEPE_MERCHANT_ID=
# Must equal PhonePe status.merchantId exactly (letter O vs digit 0 matter).
# Example shape: M228BKUPOJQVQ — NOT the Client ID (SU…).
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_AUTH_URL=https://api.phonepe.com/apis/identity-manager
PHONEPE_PG_URL=https://api.phonepe.com/apis/pg
PHONEPE_MOCK_MODE=false
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# V1 only — unused by PG V2 (do not set):
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=

STORE_URL=https://elecmoon.com
ADMIN_URL=https://admin.elecmoon.com
PUBLIC_API_URL=https://api.elecmoon.com
PAYMENT_ALLOWED_ORIGINS=https://elecmoon.com,https://www.elecmoon.com,https://admin.elecmoon.com,https://api.elecmoon.com
PAYMENT_ALLOW_LOCALHOST=false
PAYMENT_PENDING_TTL_MINUTES=15
CRON_SECRET=

SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
HOST=smtp.gmail.com
EMAIL_PORT=465

# ---- Shiprocket External API ----
SHIPROCKET_ENABLED=true
SHIPROCKET_AUTO_FULFILL=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact pickup nickname from Shiprocket dashboard (Settings → Pickup addresses)
SHIPROCKET_PICKUP_LOCATION=Primary
# Same value as security token in Settings → API → Webhooks
SHIPROCKET_WEBHOOK_SECRET=
# Optional: force a courier company id; omit for Shiprocket auto-assign
# SHIPROCKET_COURIER_ID=
# Package fallbacks (cm / kg) when product length/breadth/height/weight are unset
SHIPROCKET_DEFAULT_LENGTH=10
SHIPROCKET_DEFAULT_BREADTH=15
SHIPROCKET_DEFAULT_HEIGHT=20
SHIPROCKET_DEFAULT_WEIGHT=0.5
SHIPROCKET_JOB_MAX_ATTEMPTS=3
SHIPROCKET_QUEUE_INTERVAL_MS=15000
SHIPROCKET_FAIL_ALERT_THRESHOLD=5
SHIPROCKET_TIMEOUT=15000
SHIPROCKET_MAX_RETRY=3
SHIPROCKET_RETRY_DELAY=2000
SHIPROCKET_QUEUE_CONCURRENCY=5

# ---- Monitoring (Sentry) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.05
